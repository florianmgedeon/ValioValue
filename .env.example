# Copy to .env and fill in. Never commit .env.

# --- mcp-server (Valio Aimo side) ---
VALIO_API_BASE=https://junction26.valioaimo.fi
# Offline dev: python mcp-server/dev/fake_valio_api.py and use http://127.0.0.1:8099
VALIO_API_KEY=
MCP_PORT=8001
# Shared secret between backend and mcp-server for the human approval endpoints
APPROVER_TOKEN=change-me
# PRODUCTS_FILE=data/raw/products.json   (default: data/raw/products.json, else data/products.sample.json)

# --- backend (buyer side) ---
BACKEND_PORT=8000
MCP_SERVER_URL=http://localhost:8001/mcp
DEFAULT_BUYER_ID=juvenes
# anthropic | openai | gemini | openai_compatible | scripted (no key needed, deterministic)
LLM_PROVIDER=scripted
LLM_API_KEY=
LLM_MODEL=
# only for openai_compatible (OpenRouter, Mistral, local), optional override for the others
LLM_BASE_URL=

# --- frontend ---
VITE_BACKEND_URL=http://localhost:8000
# Phone as camera (demo on a real phone in the same Wi-Fi): listen on all interfaces and tell the phone
# where the laptop is. BACKEND_HOST=0.0.0.0, PUBLIC_BASE_URL=http://<laptop LAN IP>:8000
# BACKEND_HOST=0.0.0.0
# PUBLIC_BASE_URL=http://192.168.1.20:8000
# Demo kitchen for the kitchen-agent UI
# DEFAULT_BUYER_ID=school-kitchen-espoo
