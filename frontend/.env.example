# Local FastAPI backend used as the Vite dev proxy target.
VITE_BACKEND_URL=http://localhost:8000

# Browser API base path. Keep /api for a same-origin reverse proxy in production.
VITE_API_BASE_URL=/api

# 1 = endpoints that are not built yet (2a, 2c, 2d) answer with fixtures from src/api/mock. Built endpoints are never mocked.
VITE_MOCK=0

# Name on the "Sign as …" button.
VITE_SIGNER_NAME=Anna Virtanen
